extends ../../layout/default.pug 

block main 
    .card.mb-3 
        .card-header Danh sách
        .card-body
            .row 
                .col-8 
                    //- +formChangeMulti(`${PATH_ADMIN}/blog-category/change-multi?_method=PATCH`, isDelete, "blog_Category", "danh mục bài viết")
                .col-4 
                    a(
                        href=`${PATH_ADMIN}/blog-category/create`
                        class="btn btn-outline-success"
                    ) + Thêm mới
        .card.mb-3
            .card-header Sắp xếp 
            .card-body
                .row 
                    .col-4
                table(
                    class=" table table-hover table-sm"
                    checkbox-multi
                )
                    thead 
                        tr 
                            th STT 
                            th Hình ảnh 
                            th Tiêu đề
                            th Trạng thái 
                            th Hành động
                    tbody 
                        each topic, index in topics
                            tr 
                                td #{index + 1}
                                td 
                                    if topic.avatar
                                        img(
                                            src=topic.avatar
                                            alt=topic.title
                                            width="80"
                                        )
                                    else
                                        | No Image
                                td #{topic.title}
                                td 
                                    if topic.status === 'active'
                                        a(
                                            href="javascript:;"
                                            class="badge bg-success"
                                        ) Hoạt động
                                    else
                                        a(
                                            href="javascript:;"
                                            class="badge bg-secondary"
                                        ) Dừng hoạt động
                                td  
                                    a(
                                        href=`${PATH_ADMIN}/topic/detail/${topic._id}`
                                    )
                                    a(
                                        href=`${PATH_ADMIN}/topic/edit/${topic._id}`
                                        class="btn btn-sm btn-primary me-2"
                                    ) Sửa
                                    a(
                                        href=`${PATH_ADMIN}/topic/delete/${topic._id}?_method=DELETE`
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Bạn có chắc chắn muốn xóa chủ đề này không?');"
                                    ) Xóa